# Copy to .env on the deployment host. Never commit real credentials.
# Use a managed PostgreSQL database with TLS in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
API_PORT=3000

# Optional worker tuning
SCHEDULED_WORKER_POLL_MS=1000
SCHEDULED_WORKER_BATCH_SIZE=10
PAYMENT_WEBHOOK_WORKER_POLL_MS=1000
PAYMENT_WEBHOOK_WORKER_BATCH_SIZE=10
PAYMENT_WEBHOOK_WORKER_LEASE_SECONDS=30
FULFILLMENT_WORKER_POLL_MS=1000
FULFILLMENT_WORKER_BATCH_SIZE=10

# Required only when enabling the fulfillment profile.
MERCHANT_PREPARATION_ENDPOINT=
MERCHANT_PREPARATION_TOKEN=
SHOPPER_COLLECTION_ENDPOINT=
SHOPPER_COLLECTION_TOKEN=
COURIER_DISPATCH_ENDPOINT=
COURIER_DISPATCH_TOKEN=
