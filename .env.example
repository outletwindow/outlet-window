# Salla OAuth is disabled unless all four settings are present.
# Use the exact HTTPS callback URL registered in the Salla developer portal.
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=https://api.example.com/api/v1/integrations/salla/oauth/callback

# Base64-encoded 32-byte key for AES-256-GCM token encryption.
# Generate outside this repository and store it in your deployment secret manager.
# Never commit a real value.
SALLA_TOKEN_ENCRYPTION_KEY=

# Moyasar webhook shared secret. Configure the same value on the Moyasar webhook endpoint.
# Inject through your deployment secret manager; never commit a real value.
MOYASAR_WEBHOOK_SECRET=
# Must match the webhook mode configured in Moyasar: false for sandbox, true for live.
# Production API refuses to start unless this is explicitly set.
MOYASAR_EXPECT_LIVE=false

# Moyasar checkout is enabled only when all three values are supplied.
# Use a server-side secret key (never a publishable key) and store it in a secret manager.
MOYASAR_SECRET_KEY=
# HTTPS customer-facing return URL registered/configured for the payment flow.
MOYASAR_PAYMENT_CALLBACK_URL=https://app.example.com/payments/moyasar/return
