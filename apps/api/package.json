{
  "name": "@outlet-window/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx ../../database/scripts/migrate.ts"
  },
  "dependencies": {
    "fastify": "5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/pg": "^8.15.5"
  }
}
