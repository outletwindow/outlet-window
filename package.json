{
  "name": "outlet-window",
  "version": "0.1.0",
  "private": true,
  "description": "Global commerce and logistics platform",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @outlet-window/api dev",
    "worker:scheduled": "pnpm --filter @outlet-window/worker start:scheduled",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "worker:fulfillment": "pnpm --filter @outlet-window/worker start:fulfillment",
    "worker:payment-webhooks": "pnpm --filter @outlet-window/worker start:payment-webhooks",
    "worker:initial-payment-captures": "pnpm --filter @outlet-window/worker start:initial-payment-captures",
    "worker:inventory-expiry": "pnpm --filter @outlet-window/worker start:inventory-expiry",
    "ops:up": "docker compose up -d --build",
    "ops:up:all": "docker compose --profile fulfillment up -d --build",
    "ops:status": "docker compose ps",
    "ops:logs": "docker compose logs -f --tail=100",
    "ops:down": "docker compose down"
  }
}
